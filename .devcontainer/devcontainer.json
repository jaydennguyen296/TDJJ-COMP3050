{
    "name": "COMP3050 Group Project",
    "dockerComposeFile": "docker-compose.yml",
    "service": "server",
    "workspaceFolder": "/workspace",
    "forwardPorts": [80, 8000],
    "customizations": {
        "vscode": {
            "extensions": [
                "vscjava.vscode-java-pack",
                "vscjava.vscode-java-test"
            ],
            "settings": {
                "java.configuration.runtimes": [
                    {
                        "name": "JavaSE-18",
                        "path": "/opt/java/openjdk",
                        "default": true
                    }
                ]
            }
        }
    },
    "overrideCommand": false,
    "postCreateCommand": "mvn -q dependency:resolve compile",
    "portsAttributes": {
        "80": { "label": "nginx → server" },
        "8000": { "label": "Java server" }
    }
}
